{
  "name": "monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Classic Minesweeper browser game",
  "author": "Ayo Ayco",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayo-run/mnswpr"
  },
  "homepage": "https://mnswpr.com",
  "scripts": {
    "test": "echo \"Warn: no test specified\"",
    "dev": "vite app",
    "start": "vite app",
